APP_NAME=apache2
CONTAINER_NAME=apache2_dev
IMAGE_NAME=apache2:dev
DOCKERFILE=./iac/apache2.dev.dockerfile

APP_LOCAL_ROOT_PATH=./roots/wwwroot
APP_SERVER_ROOT_PATH=/var/www/apache2

APP_LOCAL_ENTRYPOINT_PATH=./system/entrypoints/apache2.dev.entrypoint.sh
APP_SERVER_ENTRYPOINT_PATH=/usr/local/bin/apache2.dev.entrypoint.sh

APP_LOCAL_HTTPCONF_PATH=./system/apache2/conf/httpd.dev.conf
APP_SERVER_HTTPCONF_PATH=/etc/apache2/httpd.conf

APP_LOCAL_HTTPCONFD_PATH=./system/apache2/conf.d
APP_SERVER_HTTPCONFD_PATH=/etc/apache2/conf.d


SERVER_NAME=apache2.localhost

SERVER_PORT=80
LOCAL_PORT=80

SERVER_LOG_PATH=/var/log/apache2
LOCAL_LOG_PATH=./logs/apache2

IP=192.168.1.34
NETWORK_NAME=myNet
NETWORK_DIRVER=bridge
NETWORK_SUBNET=192.168.0.0
NETWORK_GATEWAY=192.168.0.1
NETWORK_IP_RANGE=192.168.0.0/24
