{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "dockerfile",
            "request": "launch",
            "name": "Debug Build phpapachedev.dockerfile",
            "dockerfile": "./docker/phpapache.dev.dockerfile",
            "contextPath": "${workspaceFolder}"
        },

        {
            "name": "Debug runAppEnvFile.ps1 wordpress",
            "type": "PowerShell",
            "request": "launch",
            "script": "& \"${workspaceFolder}\\scripts\\runAppEnvFile.ps1\" \"${workspaceFolder}\\env\\dev.wordpress.env\"",
            "cwd": "${cwd}"
        },
        {
            "name": "Debug build.EnvFile.ps1",
            "type": "PowerShell",
            "request": "launch",
            "script": "\"${workspaceFolder}\\scripts\\build.EnvFile.ps1\" -EnvFile \"${workspaceFolder}\\env\\dev.phpapache.env\"",
            "cwd": "${cwd}"
        },
        {
            "name": "Debug test.network.ps1",
            "type": "PowerShell",
            "request": "launch",
            "script": "\"${workspaceFolder}\\scripts\\tests\\test.networks.ps1\"",
            "cwd": "${cwd}"
        },
        {
            "name": "Debug run.FromEnvFile.ps1",
            "type": "PowerShell",
            "request": "launch",
            "script": "\"${workspaceFolder}\\scripts\\run.FromEnvFile.ps1\" -EnvFile \"${workspaceFolder}\\env\\dev.phpapache.env\" -NetworkFile \"${workspaceFolder}\\env\\dev.network.env\"",
            "cwd": "${cwd}"
        },
        {
            "name": "Debug launchSecurityanalizer.ps1",
            "type": "PowerShell",
            "request": "launch",
            "script": "\"${workspaceFolder}\\scripts\\launchSecurityanalizer.ps1\"",
            "cwd": "${cwd}"
        },
        {
            "name": "Launch apache edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://apache.localhost",
            "webRoot": "${workspaceFolder}/wwwroot"
        },
        {
            "name": "Launch phpapache edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://phpapache.localhost:81",
            "webRoot": "${workspaceFolder}/wwwroot"
        },
        {
            "name": "Launch phpinfo phpapache edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://phpapache.localhost:81/php-info",
            "webRoot": "${workspaceFolder}/wwwroot"
        },
        {
            "name": "Launch wordpress edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://wordpress.localhost",
            "webRoot": "${workspaceFolder}/wordpress"
        }
    ],
    "compounds": [
        {
            "name": "Launch phpinfo and phpapache edge",
            "configurations": [
                "Launch phpinfo phpapache edge",
                "Launch phpapache edge"
            ]
        }
    ]
}