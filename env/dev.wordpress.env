HTTP_IMAGE_NAME=phpapache_wordpress:dev
HTTP_CONTAINER_NAME=WordPress_dev
HTTP_DOCKERFILE_PATH=./docker/phpapache.dev.dockerfile
BUILD_HTTP_APK_REQ=php8.5-curl php8.5-gd php8.5-mbstring php8.5-intl php8.5-mysqli php8.5-xml php8.5-zip php8.5-ctype php8.5-dom php8.5-iconv php8.5-simplexml php8.5-openssl php8.5-sodium php8.5-tokenizer php8.5-xdebug php8.5-xmlreader php8.5-fileinfo php8.5-xmlwriter php8.5-pear

HTTP_NAME=wordpress.localhost
HTTP_SERVER_PORT=82
HTTP_LOCAL_PORT=83
HTTP_LOCAL_ROOT_PATH=..\wordpress
HTTP_SERVER_ROOT_PATH=/var/www/wordpress
HTTP_LOCAL_INFO_PATH=..\php-info
HTTP_SERVER_INFO_PATH=/var/www/php-info
HTTP_ALIAS_INFO_PATH=..\php-info
HTTP_LOCAL_LOG_PATH=..\logs\wordpress
HTTP_SERVER_LOG_PATH=/var/log/apache2
HTTP_IP=192.168.2.34

DB_CONTAINER_NAME=db_mariadbWordPress_dev
DB_DOCKERFILE_PATH=./docker/mariadb.dev.dockerfile
DB_IMAGE_NAME=db_mariadb_wordpress:dev
DB_SERVER_ID=1
DB_SERVER_PORT=3306
DB_LOCAL_PORT=3306
DB_SERVER_DATA_DIR=/var/lib/mariadbwordpressdata
DB_LOCAL_DATA_DIR=..\data\db\mariadbwordpress_dev
DB_SERVER_LOG=/var/log/mysql
DB_LOCAL_LOG_PATH=..\logs\db\mariadbwordpress_dev

DB_NAME=wordpressdb
DB_USER=devwpuser
DB_PASS=devwppass

DB_IP=192.168.2.51
NETWORK_DRIVER=bridge
NETWORK_NAME=myWordPressNet
NETWORK_SUBNET=192.168.2.0/24
NETWORK_SUBNET_GATEWAY=192.168.2.1

APP_NAME=WordPress
APP_GITHUB_URL=https://github.com/WordPress/WordPress.git
APP_LOCAL_PATH=.\wordpress
APP_COMPOSE_PATH=.\docker\app.docker-compose.yml
APP_ENTRYPOINT_LOCAL_PATH=.\app\wordpress\entrypoint-wordpress.sh
APP_ENTRYPOINT_SERVER_PATH=/entrypoint-wordpress.sh

APP_ADMIN_USER=admin
APP_ADMIN_PASS=adminpass
APP_ADMIN_EMAIL=a@a.com