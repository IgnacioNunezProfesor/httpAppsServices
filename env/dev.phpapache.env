# This file contains environment variables for the PHP-Apache Docker container in development mode.
CONTAINER_NAME=phpapache_dev
DOCKERFILE=./docker/phpapache.dev.dockerfile
IMAGE_NAME=phpapache:dev
BUILD_HTTP_APK_REQ=php-curl php-gd php-mbstring php-intl php-mysqli php-xml php-zip php-ctype php-dom php-iconv php-simplexml php-openssl php-sodium php-tokenizer php-xdebug php-xmlreader php-fileinfo php-xmlwriter phpunit php-pear

SERVER_NAME=phpapache.localhost
SERVER_ID=1

SERVER_PORT=81
LOCAL_PORT=81

LOCAL_ROOT_PATH=..\wwwroot
SERVER_ROOT_PATH=/var/www/html

LOCAL_INFO_PATH=..\php-info
SERVER_INFO_PATH=/var/www/php-info
ALIAS_INFO_PATH=/php-info

LOCAL_LOG_PATH=../logs/phpapache
SERVER_LOG_PATH=/var/log/apache2

IP=192.168.1.33
NETWORK_NAME=myNet