APP_LOCAL_PATH=.\moodle
APP_APACHE_CONFIG_PATH=.\app\moodle\http
APP_COMPOSE_PATH=.\docker\app.docker-compose.yml
APP_ENTRYPOINT_LOCAL_PATH=.\app\moodle\entrypoint-moodle.sh
APP_ENTRYPOINT_SERVER_PATH=/entrypoint-moodle.sh

