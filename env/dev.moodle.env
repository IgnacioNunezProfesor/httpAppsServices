DB_LOCAL_DATA_DIR=../data/db/mariadbmoodle_dev
DB_SERVER_LOG=/var/log/mysql
DB_LOCAL_LOG_PATH=../logs/db/mariadbmoodle_dev

DB_NAME=moodledb
DB_USER=devmoodleuser
DB_PASS=devmoodleepass
DB_IP=192.168.3.52
NETWORK_DRIVER=bridge
NETWORK_ALIAS=MoodleNET
NETWORK_NAME=myMoodleNet
NETWORK_SUBNET=192.168.3.0/24
NETWORK_SUBNET_GATEWAY=192.168.3.1

APP_NAME=Moodle
APP_GITHUB_URL=https://github.com/Moodle/Moodle.git
