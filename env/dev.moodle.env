HTTP_IMAGE_NAME=phpapache_moodle:dev
HTTP_CONTAINER_NAME=Moodle_dev
HTTP_DOCKERFILE_PATH=./docker/phpapache.dev.dockerfile
BUILD_HTTP_APK_REQ=a2enmod rewrite php-bcmath php-bz2 php-soap php-ldap php-pgsql php-pdo php-pdo_mysql php-pdo_pgsql php-exif php-zip php-opcache php-ctype php-json php-session php-sodium php-pecl-redis php-pecl-memcached php-openssl php-curl php-iconv php-intl php-mbstring php-gd php-xml php-xdebug php-simplexml php-dom php-xmlreader php-fileinfo php-tokenizer php-xmlwriter composer git unzip

HTTP_NAME=moodle.localhost
HTTP_SERVER_PORT=80
HTTP_LOCAL_PORT=81
HTTP_LOCAL_ROOT_PATH=../moodle
HTTP_SERVER_ROOT_PATH=/var/www/moodle/public
HTTP_LOCAL_DATA_PATH=../moodledata
HTTP_SERVER_DATA_PATH=/var/www/moodledata
HTTP_LOCAL_INFO_PATH=../php-info
HTTP_SERVER_INFO_PATH=/var/www/php-info
HTTP_ALIAS_INFO_PATH=/php-info
HTTP_LOCAL_LOG_PATH=../logs/apache2
HTTP_SERVER_LOG_PATH=/var/log/apache2
HTTP_IP=192.168.3.35

DB_CONTAINER_NAME=db_mariadbMoodle_dev
