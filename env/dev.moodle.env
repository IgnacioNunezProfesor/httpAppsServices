HTTP_IMAGE_NAME=phpapache_moodle:dev
HTTP_CONTAINER_NAME=Moodle_dev
HTTP_DOCKERFILE_PATH=./docker/phpapache.dev.dockerfile
BUILD_HTTP_APK_REQ=php83-bcmath php83-bz2 php83-soap php83-ldap php83-pgsql php83-pdo php83-pdo_mysql php83-pdo_pgsql php83-exif php83-zip php83-opcache php83-ctype php83-session php83-sodium php83-pecl-redis php83-pecl-memcached php83-openssl php83-curl php83-iconv php83-intl php83-mbstring php83-gd php83-xml php83-pecl-xdebug php83-simplexml php83-dom php83-xmlreader php83-fileinfo php83-tokenizer php83-xmlwriter composer git unzip
HTTP_NAME=moodle.localhost
HTTP_SERVER_PORT=80
HTTP_LOCAL_PORT=81
HTTP_LOCAL_ROOT_PATH=../moodle
HTTP_SERVER_ROOT_PATH=/var/www/moodle
HTTP_LOCAL_DATA_PATH=../moodledata
HTTP_SERVER_DATA_PATH=/var/www/moodledata
HTTP_LOCAL_INFO_PATH=../php-info
HTTP_SERVER_INFO_PATH=/var/www/php-info
HTTP_ALIAS_INFO_PATH=/php-info
HTTP_LOCAL_LOG_PATH=../logs/apache2
HTTP_SERVER_LOG_PATH=/var/log/apache2
HTTP_IP=192.168.3.35

DB_CONTAINER_NAME=db_mariadbMoodle_dev
DB_DOCKERFILE_PATH=./docker/mariadb.dev.dockerfile
DB_IMAGE_NAME=db_mariadb_moodle:dev
DB_SERVER_ID=2
