NETWORK_DRIVER=bridge
NETWORK_ALIAS=MoodleNET
NETWORK_NAME=myMoodleNet
NETWORK_SUBNET=192.168.3.0/24
NETWORK_SUBNET_GATEWAY=192.168.3.1

APP_NAME=Moodle
APP_GITHUB_URL=https://github.com/moodle/moodle.git
