HTTP_IMAGE_NAME=phpapache:dev
HTTP_CONTAINER_NAME=Moodle_dev
HTTP_DOCKERFILE_PATH=./docker/phpapache.dev.dockerfile


HTTP_NAME=moodle.localhost

HTTP_PORT=81

HTTP_LOCAL_ROOT_PATH=.\moodle
HTTP_SERVER_ROOT_PATH=/var/www/moodle

HTTP_LOCAL_INFO_PATH=.\php-info
HTTP_SERVER_INFO_PATH=/var/www/php-info
HTTP_ALIAS_INFO_PATH=/php-info

HTTP_LOCAL_LOG_PATH=.\logs\moodle
HTTP_SERVER_LOG_PATH=/var/log/apache2

HTTP_IP=192.168.3.35

DB_CONTAINER_NAME=db_mariadbMoodle_dev
DB_DOCKERFILE_PATH=./docker/mariadb.dev.dockerfile
DB_IMAGE_NAME=db_mariadb:dev

DB_SERVER_ID=2

DB_SERVER_PORT=3307
DB_LOCAL_PORT=3307

DB_SERVER_DATA_DIR=/var/lib/mariadbmoodledata
DB_LOCAL_DATA_DIR=.\data\db\mariadbmoodle_dev

DB_SERVER_LOG=/var/log/mysql
DB_LOCAL_LOG_PATH=.\logs\db\mariadbmoodle_dev

DB_NAME=moodledb
DB_USER=devmoodleuser
DB_PASS=devmoodleepass

DB_IP=192.168.3.52
NETWORK_DRIVER=bridge
NETWORK_NAME=myMoodleNet
NETWORK_SUBNET=192.168.3.0/24
NETWORK_SUBNET_GATEWAY=192.168.3.1

APP_NAME=Moodle
APP_GITHUB_URL=https://github.com/Moodle/Moodle.git
APP_LOCAL_PATH=.\moodle
APP_COMPOSER_PATH=.\composer\app.composer.yml
APP_MOODLE_ADMIN_USER=admin
APP_MOODLE_ADMIN_PASS=adminpass
APP_MOODLE_ADMIN_EMAIL=a@a.com
APP_ENTRYPOINT_PATH=.\app\moodle\entrypoint-moodle.sh
BUILD_APK_REQ="php-xmlrpc php-soap php-ldap php-pgsql php-pdo php-pdo_mysql php-pdo_pgsql php-exif php-zip php-opcache php-ctype php-json php-session php-sodium php-pecl-redis php-pecl-memcached"
